# Unreal Engine .gitignore
# Project: SC&H - Wattleview Grove - Dementia VR Experience

# Build artefacts - regenerated, never commit
Binaries/
Plugins/*/Binaries/
Intermediate/
Plugins/*/Intermediate/
DerivedDataCache/
Saved/

# Generated project files
*.sln
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
*.xcodeproj
*.xcworkspace
.vs/
.idea/

# Compiled objects and libraries
*.o
*.obj
*.slo
*.lo
*.gch
*.pch
*.so
*.dylib
*.dll
*.lib
*.a
*.la
*.lai
*.exe
*.out
*.app
*.ipa
*.apk
*.aab
*.mod

# Built lighting/map data - large, regenerated on build
*_BuiltData.uasset
# Baked lighting for our maps must ship with the map (a clean checkout would build unlit)
!Content/Wattleview/Maps/*_BuiltData.uasset

# Build folder, but keep config that must be versioned
/Build/*
!/Build/*/
!/Build/**/*.ico
!/Build/*/PakBlacklist*.txt

# Source art originals (keep these out of the runtime project)
SourceArt/**/*.png
SourceArt/**/*.tga

# OS noise
Thumbs.db
desktop.ini
.DS_Store

# Secrets - never commit credentials or signing keys
*.keystore
*.jks
.env
.env.*
*_credentials.json

# --- MCP tooling (local dev tool, not a project dependency) ---
# UnrealMCPython is editor-only and Win64-only. It ships precompiled binaries
# which the Binaries/ rule above would strip anyway, leaving a broken plugin for
# anyone who cloned it. Each developer installs their own - see README "MCP setup".
Plugins/UnrealMCPython/

# Python virtualenvs and caches (uv creates .venv for the MCP server)
.venv/
__pycache__/
*.pyc

# Local MCP client config - contains machine-specific absolute paths
.mcp.json

# Packaged build output (APK/OBB) - large binaries, reproducible from source
/Build/

# Blender asset pipeline: agent scratch renders and re-downloadable sources
SourceArt/Room/Previews/Assembly_*/
SourceArt/Room/Items/sky_src/
SourceArt/Room/Items/*.blend1
SourceArt/Room/*.blend1

# MetaHuman desktop-only photo build (EnzoYoung, Cinematic): regenerate with assemble_metahumans.py
Content/MetaHumans/Photo/
